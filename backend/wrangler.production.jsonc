{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tala-study-sync",
  "main": "worker.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://aboodsharef-maker.github.io",
    "READ_ONLY": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tala-study-sync",
      "database_id": "8eb9b543-6171-4594-8d45-8d20969c5c31",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
